{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/auth", "destination": "/auth.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/setconference", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/random", "destination": "/index.html" },
    { "source": "/calendar", "destination": "/index.html" },
    { "source": "/projects", "destination": "/index.html" },
    { "source": "/checkin", "destination": "/index.html" },
    { "source": "/voting", "destination": "/index.html" },
    { "source": "/vote", "destination": "/index.html" },
    { "source": "/queue", "destination": "/index.html" },
    { "source": "/raise", "destination": "/index.html" },
    { "source": "/stream", "destination": "/index.html" },
    { "source": "/files", "destination": "/index.html" },
    { "source": "/notes", "destination": "/index.html" },
    { "source": "/summary", "destination": "/index.html" },
    { "source": "/members", "destination": "/index.html" },
    { "source": "/database", "destination": "/index.html" },
    { "source": "/chat", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/home", "destination": "/index.html" },
    { "source": "/seats", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
