  <script src="/js/components/stream.js"></script>
  <script src="/js/views/navigation.js"></script>
  <script src="/js/views/userView.js"></script>
  <script src="/js/views/adminView.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
